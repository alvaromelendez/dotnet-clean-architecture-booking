<?xml version="1.0" encoding="utf-8"?>
<!-- Restores only from nuget.org, so builds do not depend on feeds configured on a particular machine. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
