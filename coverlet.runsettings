<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for coverlet.collector, passed to `dotnet test` with the settings and
  collect ("XPlat Code Coverage") options by scripts/coverage.sh and scripts/coverage.ps1.
  Exclusions remove code whose coverage says nothing about the quality of the tests.
  Everything that contains behavior (mappings, setup, handlers, domain logic) stays measured.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Measure production assemblies only; test projects are not the subject of coverage. -->
          <Include>[BookingSystem.Domain]*,[BookingSystem.Application]*,[BookingSystem.Infrastructure]*,[BookingSystem.Api]*</Include>

          <!--
            Program: top-level statements that only call the setup extension methods (which stay measured).
            The integration tests host it through WebApplicationFactory, but its line count says nothing new.
            ApplicationDbContextFactory: design-time factory used only by the `dotnet ef` CLI, never at runtime.
          -->
          <Exclude>[BookingSystem.Api]Program,[BookingSystem.Infrastructure]BookingSystem.Infrastructure.Persistence.ApplicationDbContextFactory</Exclude>

          <!--
            Compiler- and tool-generated code: record/async/lambda plumbing and source generators
            (LoggerMessage, OpenAPI XML comments) are not written by us and cannot be meaningfully tested.
            ExcludeFromCodeCoverage is honored so a future explicit opt-out is visible in the source.
          -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

          <ExcludeByFile>
            <!-- EF Core migrations and the model snapshot are generated by `dotnet ef migrations add`;
                 the integration tests verify them as a whole (MigrationTests), not line by line. -->
            **/Migrations/*.cs,
            <!-- Source-generator output written under obj/ (e.g. *.g.cs, OpenApiXmlCommentSupport.generated.cs). -->
            **/obj/**/*.cs,
            <!-- Application DTOs, commands, queries and responses: positional records with no behavior. -->
            **/BookingSystem.Application/**/*Dto.cs,
            **/BookingSystem.Application/**/*Command.cs,
            **/BookingSystem.Application/**/*Query.cs,
            **/BookingSystem.Application/**/*Response.cs,
            <!-- Api contracts: request/response records and the status enum exposed over HTTP.
                 The *ContractMappings.cs files in the same folder contain logic and stay measured. -->
            **/BookingSystem.Api/Contracts/**/*Request.cs,
            **/BookingSystem.Api/Contracts/**/*Response.cs,
            **/BookingSystem.Api/Contracts/**/*Contract.cs
          </ExcludeByFile>

          <!-- Auto-implemented property accessors have no logic of their own. -->
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
