# Copy to .env (git-ignored) and replace the placeholder password before running `docker compose up`.
# The password ends up in a connection string: do not use ';' in it.
POSTGRES_DB=booking_system
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Host port of the API container.
API_PORT=8080
# Production (default) or Development. Development also serves /openapi/v1.json and the Scalar UI at /scalar.
API_ENVIRONMENT=Production
